{
    "name": "hanaboso/rest-bundle",
    "description": "Hanaboso - rest-bundle",
    "license": "Apache-2.0",
    "version": "1.6.0",
    "autoload": {
        "psr-4": {
            "Hanaboso\\RestBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hanaboso\\RestBundleTests\\": "tests"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "hanaboso/utils": "^2.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/serializer": "^8.0"
    },
    "require-dev": {
        "hanaboso/php-check-utils": "^2.0",
        "symfony/yaml": "^8.0"
    },
    "conflict": {
        "friendsofsymfony/rest-bundle": "*",
        "nelmio/cors-bundle": "*"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        }
    }
}
